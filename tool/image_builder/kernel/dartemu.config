# Kernel configuration fragment for dartEMU guests.
#
# Merged over arch/riscv/configs/defconfig. Everything the emulator presents
# must be built in rather than modular: the kernel has to reach its root
# filesystem before any module could be loaded from it.
#
# The emulator provides no HTIF console driver to a modern kernel and no
# firmware, so the console and the timer both come from the SBI implemented
# in lib/src/machine/sbi.dart.

CONFIG_NONPORTABLE=y

# --- Platform -----------------------------------------------------------
# A single hart, so no SMP, no hotplug and no hart state management.
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1

# --- Console ------------------------------------------------------------
# The SBI console works in both directions, so a kernel built with
# CONFIG_HVC_RISCV_SBI and no VirtIO console does reach a usable shell. It is
# just far slower to type at: the driver polls a byte per environment call,
# which measured 31s against 1.5s over VirtIO for the same 128KB written into
# the guest. Early output still comes from earlycon, which runs before any
# device probes, but hvc0 belongs to VirtIO.
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_DRIVER=y
# CONFIG_HVC_RISCV_SBI is not set
CONFIG_RISCV_SBI_V01=y

# --- Interrupts and time ------------------------------------------------
# The device tree advertises riscv,plic0, which the SiFive PLIC driver still
# matches. Timers arrive through the SBI TIME extension.
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# --- VirtIO -------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y

# --- Root filesystem ----------------------------------------------------
# The shipped images are ext2; the ext4 driver serves ext2 and ext3 too.
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT23=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Host directory sharing --------------------------------------------
# Matches the 9P transport in lib/src/device/virtio/virtio_9p.dart.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- Trimming -----------------------------------------------------------
# None of this has hardware behind it in the emulator, and every megabyte of
# Image is a megabyte the interpreter has to fault in at boot.
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_WLAN is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_MODULES is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_EFI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set

# Subsystems the stock defconfig probes for on hardware the emulator does not
# present. Each one announced itself in the boot log while finding nothing.
# CONFIG_CAN is not set
# CONFIG_IP_VS is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIOLIB is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_MD is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_POWER_RESET is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_CRYPTO_USER_API is not set

# A page-table self-test that runs on every boot and finds nothing wrong.
# CONFIG_DEBUG_VM_PGTABLE is not set

# Instrumentation, which dominates the image: the stock defconfig reports
# roughly 5MB of rwdata and 4MB of rodata, most of it tracing tables and
# symbol names rather than code. A guest this small is debugged from the
# emulator side instead.
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_STACKTRACE is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set

# --- Size ---------------------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Section alignment dominates the image. Mapping the kernel with distinct
# permissions rounds .text, .rodata and .data up to 2MB boundaries, and the
# gaps are written out as zeroes: about 7MB of a 15MB image is padding. The
# guest is already confined by the emulator, so pack the sections instead.
# CONFIG_STRICT_KERNEL_RWX is not set
# CONFIG_STRICT_MODULE_RWX is not set

# Drivers and tables for hardware that is not on this machine. The symbol
# table showed each of these near the top: a HID usage table, SELinux class
# maps, Realtek PHY descriptors and the ZSTD compressor.
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set

# AppArmor is what drags in the ZSTD compressor, which showed up in the
# symbol table well ahead of anything the guest uses. The emulator is the
# security boundary here, not a policy loaded inside the guest.
# CONFIG_SECURITY_APPARMOR is not set

# Real network cards and their PHYs. The only interface is virtio-net, which
# sits outside CONFIG_ETHERNET and needs no PHY layer.
# CONFIG_ETHERNET is not set
# CONFIG_WIRELESS is not set
# CONFIG_PHYLIB is not set

# The printk ring buffer is statically sized, and its descriptor tables were
# the two largest objects in .data at the default shift.
CONFIG_LOG_BUF_SHIFT=15
