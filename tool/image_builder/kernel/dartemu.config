# Kernel configuration fragment for dartEMU guests.
#
# Merged over arch/riscv/configs/defconfig. Everything the emulator presents
# must be built in rather than modular: the kernel has to reach its root
# filesystem before any module could be loaded from it.
#
# The emulator provides no HTIF console driver to a modern kernel and no
# firmware, so the console and the timer both come from the SBI implemented
# in lib/src/machine/sbi.dart.

CONFIG_NONPORTABLE=y

# --- Platform -----------------------------------------------------------
# A single hart, so no SMP, no hotplug and no hart state management.
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1

# --- Console ------------------------------------------------------------
# earlycon=sbi covers output before any driver probes; hvc0 takes over once
# the SBI console driver registers.
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_DRIVER=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y

# --- Interrupts and time ------------------------------------------------
# The device tree advertises riscv,plic0, which the SiFive PLIC driver still
# matches. Timers arrive through the SBI TIME extension.
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# --- VirtIO -------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y

# --- Root filesystem ----------------------------------------------------
# The shipped images are ext2; the ext4 driver serves ext2 and ext3 too.
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT23=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Host directory sharing --------------------------------------------
# Matches the 9P transport in lib/src/device/virtio/virtio_9p.dart.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- Trimming -----------------------------------------------------------
# None of this has hardware behind it in the emulator, and every megabyte of
# Image is a megabyte the interpreter has to fault in at boot.
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_WLAN is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_MODULES is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_EFI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set

# --- Size ---------------------------------------------------------------
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
