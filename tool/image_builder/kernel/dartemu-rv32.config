# RV32 overrides, merged after dartemu.config.
#
# Upstream treats 32-bit RISC-V as a non-portable target, so CONFIG_NONPORTABLE
# is what makes ARCH_RV32I selectable at all.

CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_ARCH_RV64I is not set
# CONFIG_64BIT is not set

# The emulator implements SV32 for RV32 guests.
CONFIG_MMU=y

# Nothing is 64-bit-clean about a compat layer on a 32-bit kernel.
# CONFIG_COMPAT is not set
